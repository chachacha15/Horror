  monologueLines:
  - "2022\u5E74X\u6708Y\u65E5\u3001\u79C1\u306F\u3042\u308B\u30DB\u30C6\u30EB\u306B\u8A2A\u308C\u3066\u3088\u3046\u3068\u3057\u3066\u3044\u305F\u3002"
  - "\u306A\u3093\u3067\u3082\u3053\u306E\u30DB\u30C6\u30EB\u306F\u6B8B\u308A\u6570\u65E5\u3067\u55B6\u696D\u3092\u505C\u6B62\u3059\u308B\u305D\u3046\u3060\u3002"
  - "\u5341\u6570\u5E74\u524D\u3053\u306E\u30DB\u30C6\u30EB\u306B\u306F\u304A\u4E16\u8A71\u306B\u306A\u3063\u305F\u3053\u3068\u304C\u3042\u3063\u305F\u306E\u3067\u3001\u6700\u5F8C\u306B\u5BBF\u6CCA\u3059\u308B\u3053\u3068\u306B\u3057\u305F\u3002"
